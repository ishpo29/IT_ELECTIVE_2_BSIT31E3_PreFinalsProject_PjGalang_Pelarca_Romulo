@model IEnumerable<HelpDesk_System.Models.Ticket>

@{
    ViewData["Title"] = "Tickets Dashboard";
}

<a asp-action="Unassigned" class="btn btn-outline-primary btn-sm me-2">Unassigned Tickets</a>
<a asp-action="MultipleAssignees" class="btn btn-outline-primary btn-sm me-2">Multiple Assignees</a>
<a asp-action="PrimaryAssignees" class="btn btn-outline-primary btn-sm">Primary Assignee</a>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1 text-slate-800">Support Tickets</h2>
        <p class="text-muted small mb-0">Manage and track customer support requests</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-white rounded-3">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 bg-indigo-light text-primary rounded-3">
                    <i class="bi bi-ticket-perforated fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small d-block">Total Tickets</span>
                    <h4 class="fw-bold mb-0">@Model.Count()</h4>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-white rounded-3">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 bg-warning-subtle text-warning rounded-3">
                    <i class="bi bi-clock-history fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small d-block">Open / In Progress</span>
                    <h4 class="fw-bold mb-0">@Model.Count(t => !t.Status.IsClosed)</h4>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Ticket ID</th>
                    <th>Title & Category</th>
                    <th>Customer</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Date Created</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                            No tickets found in the system.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        var priorityClass = item.Priority.Name switch
                        {
                            "High" or "Urgent" => "bg-danger-subtle text-danger border-danger-subtle",
                            "Medium" => "bg-warning-subtle text-warning-emphasis border-warning-subtle",
                            _ => "bg-info-subtle text-info-emphasis border-info-subtle"
                        };

                        var statusClass = item.Status.Name switch
                        {
                            "Closed" or "Resolved" => "bg-success-subtle text-success border-success-subtle",
                            "In Progress" => "bg-primary-subtle text-primary border-primary-subtle",
                            _ => "bg-secondary-subtle text-secondary border-secondary-subtle"
                        };

                        <tr>
                            <td class="ps-4 fw-semibold text-secondary">#@item.Id</td>
                            <td>
                                <div class="fw-semibold text-dark">@item.Subject</div>
                                <small class="text-muted">@(item.Category != null ? item.Category.Name : "General")</small>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="avatar-sm rounded-circle bg-light d-flex align-items-center justify-content-center text-primary fw-bold" style="width:32px; height:32px; font-size:12px;">
                                        @(item.Customer?.ContactName?.FirstOrDefault() ?? 'C')
                                    </div>
                                    <div>
                                        <div class="fw-semibold text-dark">@(item.Customer?.ContactName ?? "N/A")</div>
                                        @if (!string.IsNullOrEmpty(item.Customer?.CompanyName))
                                        {
                                            <small class="text-muted d-block" style="font-size: 0.75rem;">@item.Customer.CompanyName</small>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge border rounded-pill @priorityClass px-2 py-1">
                                    @item.Priority.Name
                                </span>
                            </td>
                            <td>
                                <span class="badge border rounded-pill @statusClass px-2 py-1">
                                    @item.Status.Name
                                </span>
                            </td>
                            <td class="text-muted small">
                                @item.CreatedAt
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light border text-secondary me-1">
                                    <i class="bi bi-eye"></i> Details
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>