@model IEnumerable<HelpDesk_System.Models.ViewModels.DepartmentWorkloadViewModel>

@{
    ViewData["Title"] = "Department Workload";
}

<h2>Department Workload</h2>

<table class="table table-hover align-middle mt-3">
    <thead class="table-light">
        <tr>
            <th>Department</th>
            <th>Employee Count</th>
            <th>Unresolved Tickets</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.DepartmentName</td>
                <td>@item.EmployeeCount</td>
                <td>@item.UnresolvedTicketCount</td>
            </tr>
        }
    </tbody>
</table>
