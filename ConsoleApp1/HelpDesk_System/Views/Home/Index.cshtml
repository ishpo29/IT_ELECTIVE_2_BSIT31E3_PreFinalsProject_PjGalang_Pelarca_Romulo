@{
    ViewData["Title"] = "Home";
}

<div class="mb-4">
    <p class="text-muted mb-0">Jump into a module below to browse records, review workload, or triage tickets.</p>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <a href="/Tickets" class="text-decoration-none">
            <div class="card p-4 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 bg-indigo-light text-primary rounded-3">
                        <i class="bi bi-ticket-perforated fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-1 text-dark">Tickets</h5>
                        <p class="text-muted small mb-0">Browse tickets, view unassigned or multi-assignee reports</p>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-4">
        <a href="/Customers" class="text-decoration-none">
            <div class="card p-4 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 bg-indigo-light text-primary rounded-3">
                        <i class="bi bi-people fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-1 text-dark">Customers</h5>
                        <p class="text-muted small mb-0">View customer contacts and account status</p>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-4">
        <a href="/Employees" class="text-decoration-none">
            <div class="card p-4 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 bg-indigo-light text-primary rounded-3">
                        <i class="bi bi-person-badge fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-1 text-dark">Employees</h5>
                        <p class="text-muted small mb-0">Staff directory and workload report</p>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-4">
        <a href="/Departments" class="text-decoration-none">
            <div class="card p-4 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 bg-indigo-light text-primary rounded-3">
                        <i class="bi bi-building fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-1 text-dark">Departments</h5>
                        <p class="text-muted small mb-0">Department listing and workload report</p>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-4">
        <a href="/Teams" class="text-decoration-none">
            <div class="card p-4 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 bg-indigo-light text-primary rounded-3">
                        <i class="bi bi-people-fill fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-1 text-dark">Teams</h5>
                        <p class="text-muted small mb-0">Team rosters by department</p>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-4">
        <a href="/Categories" class="text-decoration-none">
            <div class="card p-4 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 bg-indigo-light text-primary rounded-3">
                        <i class="bi bi-tags fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-1 text-dark">Categories</h5>
                        <p class="text-muted small mb-0">Category hierarchy and structure</p>
                    </div>
                </div>
            </div>
        </a>
    </div>
</div>
